# Copia este archivo a .env y reemplaza los valores. NUNCA subas .env a GitHub.
FLASK_SECRET_KEY=genera-una-clave-local-larga-y-aleatoria

# Opción A (recomendada, la misma que usarás en Render): una sola URL.
# DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_bd

# Opción B (PostgreSQL instalado en tu computadora):
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_contrasena_postgres
DB_NAME=encuestas_ingenieria

GEMINI_API_KEY=pega_aqui_tu_clave_de_google_ai_studio
# Coloca un ID de modelo disponible para tu API/clave.
GEMINI_MODEL=gemini-2.5-flash

# Opcional: si lo defines, la sección /estrategia pide contraseña (usuario: cualquiera).
# ADMIN_PASSWORD=una-contrasena-larga
